{%- doc -%}
  Styles for the portal newsletter section. Extracted into a snippet
  following the theme's *-styles convention so the CSS ships only when
  the section is used.
{%- enddoc -%}

{% stylesheet %}
  /*
   * The section keeps the theme's .section grid: media and overlay are
   * absolutely positioned behind, the content block lands in the page
   * column via .section > * rules (center column on page-width).
   */
  .portal-newsletter {
    position: relative;
    overflow: hidden;
    isolation: isolate;
  }

  .portal-newsletter[data-shopify-visual-preview] {
    min-height: 500px;
  }

  .portal-newsletter__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .portal-newsletter:not(.portal-newsletter--has-media) {
    background-color: var(--color-background);
  }

  .portal-newsletter__content {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--gap-lg);
    width: 100%;
    min-height: inherit;
    align-items: center;
    justify-content: center;
    padding-inline: var(--page-margin);
  }

  .portal-newsletter__content--left {
    align-items: flex-start;
    text-align: left;
  }

  .portal-newsletter__content--right {
    align-items: flex-end;
    text-align: right;
  }

  .portal-newsletter__content--v-top {
    justify-content: flex-start;
  }

  .portal-newsletter__content--v-bottom {
    justify-content: flex-end;
  }
{% endstylesheet %}
