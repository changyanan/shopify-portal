{%- doc -%}
  Styles for the portal brand story section. Extracted into a snippet
  following the theme's *-styles convention so the CSS ships only when
  the section is used.
{%- enddoc -%}

{% stylesheet %}
  .portal-brand-story {
    display: grid;
    grid-template-columns: 1fr;
    grid-template-areas: 'media' 'content';
    gap: var(--portal-brand-story-gap, 32px);
    align-items: center;
  }

  @media screen and (min-width: 750px) {
    .portal-brand-story {
      grid-template-columns: var(--portal-brand-story-columns, 1fr 1fr);
      grid-template-areas: 'media content';
    }

    .portal-brand-story--media-right {
      grid-template-areas: 'content media';
    }

    .portal-brand-story--media-narrow {
      --portal-brand-story-columns: 1fr 2fr;
    }

    .portal-brand-story--media-medium {
      --portal-brand-story-columns: 1fr 1fr;
    }

    .portal-brand-story--media-wide {
      --portal-brand-story-columns: 3fr 2fr;
    }
  }

  /* Higher specificity than the base `.section > *` column rule */
  .portal-brand-story .portal-brand-story__media {
    grid-area: media;
  }

  .portal-brand-story .portal-brand-story__content {
    grid-area: content;
  }

  .portal-brand-story__media {
    grid-area: media;
    position: relative;
    overflow: hidden;
    border-radius: var(--style-border-radius-xs);
    min-height: var(--portal-brand-story-media-height-mobile, auto);

    @media screen and (min-width: 750px) {
      min-height: var(--portal-brand-story-media-height, auto);
      height: var(--portal-brand-story-media-height, auto);
    }
  }

  .portal-brand-story__asset {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
  }

  .portal-brand-story__placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    min-height: var(--portal-brand-story-media-height, 320px);
  }

  .portal-brand-story__placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .portal-brand-story__content {
    display: flex;
    flex-direction: column;
    gap: var(--gap-md);
    align-items: flex-start;
    justify-content: center;
  }

  .portal-brand-story__content--center {
    align-items: center;
    text-align: center;
  }

  .portal-brand-story__content--right {
    align-items: flex-end;
    text-align: right;
  }
{% endstylesheet %}
