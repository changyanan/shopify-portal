{%- doc -%}
  Styles for the portal selling points section. Extracted into a snippet
  following the theme's *-styles convention so the CSS ships only when
  the section is used.
{%- enddoc -%}

{% stylesheet %}
  /*
   * The section keeps the theme's .section grid (content stays in the page
   * column); we only add row spacing between header and grid, mirroring the
   * official resource-list sections.
   */
  .portal-selling-points-section {
    row-gap: var(--gap-xl);
  }

  .portal-selling-points__header {
    display: flex;
    flex-direction: column;
    gap: var(--gap-sm);
    max-width: 60rem;
  }

  .portal-selling-points__header--center {
    align-items: center;
    text-align: center;
  }

  .portal-selling-points__header--right {
    align-items: flex-end;
    text-align: right;
  }

  .portal-selling-points__heading {
    margin: 0;
  }

  .portal-selling-points__description {
    margin: 0;
  }

  .portal-selling-points__description > * {
    margin-block: 0;
  }

  .portal-selling-points {
    display: grid;
    grid-template-columns: repeat(var(--portal-sp-columns, 4), 1fr);
    gap: var(--portal-sp-gap, 24px);
  }

  @media screen and (max-width: 749px) {
    .portal-selling-points {
      grid-template-columns: repeat(var(--portal-sp-columns-mobile, 2), 1fr);
    }
  }
{% endstylesheet %}
