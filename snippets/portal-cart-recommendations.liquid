{%- doc -%}
  Portal 定制:购物车抽屉推荐商品(挂载点)。

  在购物车抽屉中渲染 <portal-cart-recommendations> 自定义元素,
  由 assets/portal-cart-recommendations.js 调用原生推荐接口
  (/recommendations/products?section_id=portal-cart-recommendations,
  锚点取购物车最新加入的商品)拉取 sections/portal-cart-recommendations.liquid
  渲染的真实商品卡片并注入。无推荐、请求失败或购物车清空时自动隐藏。

  与主题约定一致(参见 cart-products.liquid):脚本无条件加载、
  挂载点在空/非空购物车状态下均渲染,不依赖 Section Rendering API
  重渲染时执行 script;元素默认 hidden,可见性完全由 JS 管理。
  空购物车时元素保持隐藏,不发出推荐请求。

  data-skip-node-update:抽屉走 hydration 模式 morph,跳过本节点,
  注入的内容不会被重渲染清空,由 JS 自行管理。

  @param {string} [limit] - 推荐商品数量上限,默认 4(接口上限 10)。
{%- enddoc -%}

{%- liquid
  assign limit = limit | default: 4 | plus: 0
  if limit < 1 or limit > 10
    assign limit = 4
  endif
-%}

{%- if settings.portal_cart_recommendations_enabled -%}
  <script
    type="module"
    src="{{ 'portal-cart-recommendations.js' | asset_url }}"
    fetchpriority="low"
  ></script>

  <portal-cart-recommendations
    class="portal-cart-recommendations"
    data-testid="portal-cart-recommendations"
    data-limit="{{ limit }}"
    data-section-id="portal-cart-recommendations"
    data-error-text="{{ 'portal.cart_recommendations.add_error' | t | escape }}"
    data-skip-node-update
    hidden
  >
    <div data-portal-recs-content></div>
    <p
      class="portal-cart-recommendations__error"
      role="alert"
      data-portal-recs-error
      hidden
    ></p>
  </portal-cart-recommendations>
{%- endif -%}

{% stylesheet %}
  portal-cart-recommendations {
    display: block;
    padding: 8px var(--cart-drawer-padding, 16px) 0;
  }

  portal-cart-recommendations[hidden] {
    display: none;
  }

  .portal-cart-recommendations__heading {
    margin: 0 0 10px;
    font-size: 13px;
    font-weight: 600;
    line-height: 1.3;
  }

  .portal-cart-recommendations__list {
    display: grid;
    gap: 12px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portal-cart-recommendations__item {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .portal-cart-recommendations__media {
    flex-shrink: 0;
    width: 64px;
    height: 64px;
  }

  .portal-cart-recommendations__media img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: var(--style-border-radius-images);
  }

  .portal-cart-recommendations__info {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
    gap: 2px;
  }

  .portal-cart-recommendations__title {
    overflow: hidden;
    font-size: 13px;
    line-height: 1.35;
    color: inherit;
    text-decoration: none;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .portal-cart-recommendations__title:hover {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .portal-cart-recommendations__price {
    font-size: 13px;
    color: var(--color-foreground-subdued);
  }

  .portal-cart-recommendations__price--sold-out {
    color: var(--color-error);
  }

  .portal-cart-recommendations__add {
    display: grid;
    flex-shrink: 0;
    width: var(--minimum-touch-target, 44px);
    height: var(--minimum-touch-target, 44px);
    place-items: center;
    color: var(--color-foreground);
    cursor: pointer;
    border: var(--style-border-width) solid rgb(var(--color-foreground-rgb) / var(--opacity-10-25));
    border-radius: 999px;
  }

  .portal-cart-recommendations__add:hover {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-10-25) * 2);
  }

  .portal-cart-recommendations__add[aria-busy='true'] {
    pointer-events: none;
    opacity: 0.6;
  }

  .portal-cart-recommendations__error {
    margin: 8px 0 0;
    font-size: 13px;
    color: var(--color-error);
  }
{% endstylesheet %}
