{%- doc -%}
  Portal 定制:信任徽章组(trust badges)。

  设计用于商品详情区(_product-details),放在加购按钮下方,展示免邮/退换/保修/认证等信任点。
  提供 4 个独立槽位,每槽位可单独开关并配置图标与文案;全部关闭或文案为空时整体不渲染。

  - 图标复用官方 snippets/icon.liquid 的 SVG,颜色走 currentColor 继承文字色;
  - schema 文案走 locales/*.schema.json 的 t: 翻译键(portal 命名空间);
  - 徽章文案是商家设置值,在 Translate & Adapt 中按语言翻译,不占用 storefront 翻译键。
{%- enddoc -%}

{%- liquid
  assign gap = block.settings.gap | default: 16
  assign icon_size = block.settings.icon_size | default: 16
-%}

{%- capture badge_items -%}
  {%- for i in (1..4) -%}
    {%- liquid
      assign enabled_key = 'badge_' | append: i | append: '_enabled'
      assign icon_key = 'badge_' | append: i | append: '_icon'
      assign text_key = 'badge_' | append: i | append: '_text'
      assign badge_enabled = block.settings[enabled_key]
      assign badge_icon = block.settings[icon_key]
      assign badge_text = block.settings[text_key]
    -%}
    {%- if badge_enabled and badge_text != blank -%}
      <li class="portal-trust-badges__item">
        {%- if badge_icon != 'none' -%}
          <svg
            class="portal-trust-badges__icon icon-default"
            aria-hidden="true"
            focusable="false"
            xmlns="http://www.w3.org/2000/svg"
            width="{{ icon_size }}"
            height="{{ icon_size }}"
            viewBox="0 0 20 20"
          >
            {%- render 'icon', icon: badge_icon -%}
          </svg>
        {%- endif -%}
        <span class="portal-trust-badges__text">{{ badge_text }}</span>
      </li>
    {%- endif -%}
  {%- endfor -%}
{%- endcapture -%}

{%- if badge_items != blank -%}
  <ul
    class="portal-trust-badges portal-trust-badges--{{ block.settings.layout }} portal-trust-badges--{{ block.settings.alignment }}"
    style="--portal-trust-badges-gap: {{ gap }}px;"
    role="list"
    {{ block.shopify_attributes }}
  >
    {{ badge_items }}
  </ul>
{%- endif -%}

{% stylesheet %}
  .portal-trust-badges {
    display: flex;
    flex-wrap: wrap;
    gap: var(--portal-trust-badges-gap, 16px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .portal-trust-badges--column {
    flex-direction: column;
  }

  .portal-trust-badges--row.portal-trust-badges--center {
    justify-content: center;
  }

  .portal-trust-badges--row.portal-trust-badges--right {
    justify-content: flex-end;
  }

  .portal-trust-badges--column.portal-trust-badges--center {
    align-items: center;
  }

  .portal-trust-badges--column.portal-trust-badges--right {
    align-items: flex-end;
  }

  .portal-trust-badges__item {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .portal-trust-badges__icon {
    flex-shrink: 0;
  }

  .portal-trust-badges__text {
    font-size: 13px;
    line-height: 1.4;
  }
{% endstylesheet %}

