{% comment %}
  Portal 定制(最小改动):在官方 main-blog 基础上新增博客列表的分页与话题标签能力:
  - 用 {% paginate %} 按设置的数量分页,复用官方 pagination-controls 或原生无限滚动;
  - 新增 blog.all_tags 标签导航(分类),激活标签高亮;
  - 文章卡片的每条 style 移入卡片元素内,便于分页追加时样式随卡片携带。
  其余布局逻辑与官方保持一致。
{% endcomment %}


<script
  src="{{ 'blog-posts-list.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{% liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
%}

<blog-posts-list section-id="{{ section.id }}">
  <div
    class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="
      section
      {% if section.settings.background_color != blank %}color-custom-{{ section.id }}{% endif %}
      blog-posts
      spacing-style
      size-style
    "
    data-testid="blog-posts"
    style="{% render 'spacing-style', settings: section.settings %}"
  >
    {% content_for 'blocks' %}

    {%- if section.settings.show_tags and blog.all_tags.size > 0 -%}
      <nav
        class="blog-tags"
        aria-label="{{ 'portal.blog.tags_label' | t }}"
      >
        <ul
          class="blog-tags__list"
          role="list"
        >
          <li>
            <a
              href="{{ blog.url }}"
              class="blog-tags__pill{% if current_tags == blank %} blog-tags__pill--active{% endif %}"
              {% if current_tags == blank %}
                aria-current="page"
              {% endif %}
            >
              {{ 'portal.blog.all_tags' | t }}
            </a>
          </li>
          {%- for tag in blog.all_tags -%}
            <li>
              {%- if current_tags contains tag -%}
                <a
                  href="{{ blog.url }}"
                  class="blog-tags__pill blog-tags__pill--active"
                  aria-current="page"
                >
                  {{ tag }}
                </a>
              {%- else -%}
                <a
                  href="{{ blog.url }}/tagged/{{ tag | handleize }}"
                  class="blog-tags__pill"
                >
                  {{ tag }}
                </a>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ul>
      </nav>
    {%- endif -%}

    {%- paginate blog.articles by section.settings.posts_per_page -%}
    <div
      ref="grid"
      class="blog-posts-container"
      data-last-page="{{ paginate.pages }}"
    >
      {% liquid
        assign items_on_page = blog.articles.size
        assign image_index = 0

        # The first two images reach the initial mobile viewport; later images use native lazy-loading.
        assign eager_image_count = 2

        # These sizes mirror --narrow-page-width in theme-styles-variables.liquid,
        # --page-margin in base.css, and --columns-gap plus the mobile breakpoint below.
        # Desktop content uses a 40px page margin on each side, with 36px column gaps.
        # Compact cards use three columns and two gaps, standard cards use two columns and one gap,
        # and the hero image uses 70% of the full-width card after its image-content gap.
        assign compact_image_sizes = '(min-width: 1520px) 456px, (min-width: 750px) calc(33.33vw - 51px), calc(100vw - 32px)'
        assign standard_image_sizes = '(min-width: 1520px) 702px, (min-width: 750px) calc(50vw - 58px), calc(100vw - 32px)'
        assign hero_image_sizes = '(min-width: 1520px) 983px, (min-width: 750px) calc(70vw - 81px), calc(100vw - 32px)'
      %}
      {% for article in blog.articles %}
        {% liquid
          # Defaults for compact layout
          assign col_span = 2
          assign scale = 0.6
          assign is_horizontal = false

          case items_on_page
            when 1
              # Single post: full width hero
              assign col_span = 6
              assign scale = 1
              assign is_horizontal = true
            when 2
              # Two posts: both standard side by side
              assign col_span = 3
              assign scale = 0.8
            when 3
              # Three posts: hero + 2 standard
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            when 4
              # Four posts: all standard in 2x2 grid
              assign col_span = 3
              assign scale = 0.8
            when 5
              # Five posts: hero + 4 standard
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              else
                assign col_span = 3
                assign scale = 0.8
              endif
            else
              # 6+ posts: hero, 2 standard, rest compact
              if forloop.index == 1
                assign col_span = 6
                assign scale = 1
                assign is_horizontal = true
              elsif forloop.index <= 3
                assign col_span = 3
                assign scale = 0.8
              else
                assign col_span = 2
                assign scale = 0.6
              endif
          endcase

          case col_span
            when 2
              assign image_sizes = compact_image_sizes
            when 3
              assign image_sizes = standard_image_sizes
            when 6
              assign image_sizes = hero_image_sizes
            else
              # Safe fallback for a future span; add a matching sizes value with any new layout.
              assign image_sizes = '100vw'
          endcase

          assign image_loading = 'lazy'
          assign image_fetch_priority = 'auto'
          if article.image
            assign image_index = image_index | plus: 1

            if image_index <= eager_image_count
              assign image_loading = 'eager'
            endif

            if image_index == 1
              assign image_fetch_priority = 'high'
            endif
          endif
        %}
        {% # The style block lives inside the item so section-renderer pagination can carry it along when appending pages. %}
        <div
          class="blog-post-item"
          data-testid="blog-post-item"
          data-blog-index="{{ section.id }}-{{ forloop.index }}"
          data-page="{{ paginate.current_page }}"
          ref="cards[]"
        >
          {% style %}
            [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
              --col-span: {{ col_span }};
              --blog-post-card-scale: {{ scale }};
            }

            @media screen and (max-width: 749px) {
              [data-blog-index="{{ section.id }}-{{ forloop.index }}"] {
                --col-span: 6;
                --blog-post-card-scale: 0.5;
              }
            }
          {% endstyle %}
          {% content_for 'block',
            id: 'static-blog-post-card',
            type: '_blog-post-card',
            article: article,
            image_sizes: image_sizes,
            image_loading: image_loading,
            image_fetch_priority: image_fetch_priority,
            is_horizontal: is_horizontal
          %}
        </div>
      {% endfor %}
    </div>

    {%- if paginate.pages > 1 -%}
      {%- if section.settings.pagination_style == 'infinite_scroll' -%}
        <span ref="viewMorePrevious"></span>
        <span ref="viewMoreNext"></span>
      {%- else -%}
        <div class="blog-posts-pagination">
          {%- render 'pagination-controls', paginate: paginate -%}
        </div>
      {%- endif -%}
    {%- endif -%}
    {%- endpaginate -%}
  </div>
</blog-posts-list>

{% stylesheet %}
  /**
   * Blog posts page layout
   */
  .blog-posts {
    --page-content-width: var(--narrow-page-width);
    --page-width: calc(var(--page-content-width) + (var(--page-margin) * 2));

    /* Keep the responsive image sizes above in sync with this gap. */
    --columns-gap: 36px;
    --rows-gap: 36px;
  }

  .blog-posts-container {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 1rem;
    width: 100%;
    column-gap: var(--columns-gap);
    row-gap: var(--rows-gap);
  }

  /**
   * Blog post item grid positioning and scaling.
   * Layout is calculated in Liquid based on total article count.
   * Mobile overrides are applied per-item in inline styles for proper specificity.
   */
  .blog-post-item {
    grid-column: span var(--col-span);
    background-color: var(--color-background);
  }

  /**
   * When there's no image, the blog post item has a border.
   */
  .blog-post-item {
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    padding: 0 1rem 1rem;
  }

  .blog-post-item:has(.blog-post-card__image-container) {
    border: none;
    padding: 0;
  }

  /**
   * Portal: blog topic tags (categories).
   */
  .blog-tags {
    width: 100%;
    margin-block-end: 8px;
  }

  .blog-tags__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .blog-tags__pill {
    display: inline-block;
    padding: 6px 14px;
    border: 1px solid rgb(var(--color-foreground-rgb) / var(--opacity-20));
    border-radius: 999px;
    font-size: var(--font-size--sm);
    line-height: 1.4;
    color: var(--color-foreground);
    text-decoration: none;
    transition: border-color 0.2s ease, background-color 0.2s ease;
  }

  .blog-tags__pill:hover {
    border-color: rgb(var(--color-foreground-rgb) / var(--opacity-40));
  }

  .blog-tags__pill:focus-visible {
    outline: 2px solid var(--color-foreground);
    outline-offset: 2px;
  }

  .blog-tags__pill--active {
    background-color: var(--color-foreground);
    border-color: var(--color-foreground);
    color: var(--color-background);
  }

  /**
   * Portal: numbered pagination below the article grid.
   */
  .blog-posts-pagination {
    width: 100%;
    margin-block-start: 16px;
    display: flex;
    justify-content: center;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.blog_posts",
  "blocks": [
    {
      "type": "@theme"
    },
    {
      "type": "@app"
    },
    {
      "type": "text"
    },
    {
      "type": "icon"
    },
    {
      "type": "image"
    },
    {
      "type": "button"
    },
    {
      "type": "video"
    },
    {
      "type": "group"
    },
    {
      "type": "spacer"
    },
    {
      "type": "_divider"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "checkbox",
      "id": "show_tags",
      "label": "t:portal.blog_show_tags",
      "default": true
    },
    {
      "type": "range",
      "id": "posts_per_page",
      "label": "t:portal.blog_posts_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12
    },
    {
      "type": "select",
      "id": "pagination_style",
      "label": "t:portal.blog_pagination_style",
      "options": [
        {
          "value": "pagination",
          "label": "t:portal.blog_pagination_numbered"
        },
        {
          "value": "infinite_scroll",
          "label": "t:portal.blog_pagination_infinite"
        }
      ],
      "default": "pagination"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ]
}
{% endschema %}
