{% comment %}
  Portal 定制:品牌介绍(Brand story)section。

  - 媒体区支持图片 / 视频,并支持移动端独立图片(picture 艺术方向,未上传时回退桌面图);
  - 内容区组合官方 text / button blocks(标题、副标题、正文、按钮均可在编辑器增删);
  - 图片使用 image_url + 显式 width/height/alt/loading/sizes,非首屏懒加载,避免布局跳动;
  - 支持背景色、内容宽度、媒体位置与宽度、对齐和内边距;样式在 snippets/portal-brand-story-styles.liquid。
{%- endcomment -%}

{% liquid
  assign media_class = 'portal-brand-story--media-' | append: section.settings.media_width
  if section.settings.media_position == 'right'
    assign media_class = media_class | append: ' portal-brand-story--media-right'
  endif

  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif

  assign show_desktop_image = false
  assign show_video = false
  if section.settings.media_type == 'image' and section.settings.image != blank
    assign show_desktop_image = true
  elsif section.settings.media_type == 'video' and section.settings.video != blank
    assign show_video = true
  endif

  assign show_mobile_image = false
  if section.settings.custom_mobile_media and section.settings.image_mobile != blank
    assign show_mobile_image = true
  endif

  # Mobile fallback: reuse the desktop image when no dedicated mobile asset is set.
  assign effective_mobile_image = section.settings.image_mobile
  if effective_mobile_image == blank
    assign effective_mobile_image = section.settings.image
  endif

  case section.settings.media_width
    when 'narrow'
      assign media_sizes_desktop = '35vw'
    when 'medium'
      assign media_sizes_desktop = '50vw'
    else
      assign media_sizes_desktop = '60vw'
  endcase
  assign media_sizes = '(min-width: 750px) ' | append: media_sizes_desktop | append: ', 100vw'
  assign media_widths = '480, 720, 960, 1280, 1600, 2000'
  assign media_widths_array = media_widths | split: ', '
%}

{% render 'portal-brand-story-styles' %}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>

<div
  class="section section--{{ section.settings.section_width }} spacing-style portal-brand-story {{ media_class }}{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  style="
    {% render 'spacing-style', settings: section.settings %}
    --portal-brand-story-gap: {{ section.settings.gap }}px;
    --portal-brand-story-media-height: {{ section.settings.media_height }};
    {%- case section.settings.media_height %}
      {% when '50svh' %}
        --portal-brand-story-media-height-mobile: 30svh;
      {% when '60svh' %}
        --portal-brand-story-media-height-mobile: 50svh;
      {% when '80svh' %}
        --portal-brand-story-media-height-mobile: 70svh;
      {% else %}
        --portal-brand-story-media-height-mobile: auto;
    {% endcase -%}

    {% if section.settings.media_height != 'auto' %}
      --section-preview-height: 600px;
    {% endif %}
  "
>
  <div
    class="portal-brand-story__media"
    data-testid="portal-brand-story-media"
  >
    {%- liquid
      assign has_media = false
      if show_desktop_image or show_video or effective_mobile_image != blank
        assign has_media = true
      endif
    -%}
    {%- if show_desktop_image and show_mobile_image -%}
      <picture>
        <source
          media="(max-width: 749px)"
          srcset="
            {%- for w in media_widths_array -%}
              {{ effective_mobile_image | image_url: width: w }} {{ w }}w{% unless forloop.last %}, {% endunless %}
            {%- endfor -%}
          "
          sizes="100vw"
          width="{{ effective_mobile_image.width }}"
          height="{{ effective_mobile_image.height }}"
        >
        {{
          section.settings.image
          | image_url: width: 2000
          | image_tag:
            widths: media_widths,
            sizes: media_sizes,
            width: section.settings.image.width,
            height: section.settings.image.height,
            alt: section.settings.image.alt,
            loading: 'lazy',
            class: 'portal-brand-story__asset',
            data-testid: 'portal-brand-story-desktop-image'
        }}
      </picture>
    {%- elsif show_desktop_image -%}
      {{
        section.settings.image
        | image_url: width: 2000
        | image_tag:
          widths: media_widths,
          sizes: media_sizes,
          width: section.settings.image.width,
          height: section.settings.image.height,
          alt: section.settings.image.alt,
          loading: 'lazy',
          class: 'portal-brand-story__asset',
          data-testid: 'portal-brand-story-image'
      }}
    {%- elsif show_video -%}
      {{
        section.settings.video
        | video_tag:
          poster: nil,
          autoplay: true,
          loop: true,
          controls: false,
          muted: true,
          class: 'portal-brand-story__asset',
          data-testid: 'portal-brand-story-video'
      }}
    {%- elsif effective_mobile_image != blank -%}
      {{
        effective_mobile_image
        | image_url: width: 1280
        | image_tag:
          widths: '480, 720, 960, 1280',
          sizes: '100vw',
          width: effective_mobile_image.width,
          height: effective_mobile_image.height,
          alt: effective_mobile_image.alt,
          loading: 'lazy',
          class: 'portal-brand-story__asset'
      }}
    {%- endif -%}
    {%- unless has_media -%}
      <div class="portal-brand-story__placeholder">
        {{ 'lifestyle-1' | placeholder_svg_tag: 'portal-brand-story__placeholder-svg' }}
      </div>
    {%- endunless -%}
  </div>

  <div
    class="portal-brand-story__content portal-brand-story__content--{{ section.settings.content_alignment }}"
  >
    {% content_for 'blocks' %}
  </div>
</div>

{% schema %}
{
  "name": "t:portal.brand_story_name",
  "tag": "section",
  "class": "section-wrapper",
  "blocks": [
    {
      "type": "text"
    },
    {
      "type": "button"
    },
    {
      "type": "@app"
    }
  ],
  "disabled_on": {
    "groups": ["header"]
  },
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "select",
      "id": "media_type",
      "label": "t:settings.type",
      "options": [
        {
          "value": "image",
          "label": "t:options.image"
        },
        {
          "value": "video",
          "label": "t:options.video"
        }
      ],
      "default": "image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.media_type == 'image' }}"
    },
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video",
      "visible_if": "{{ section.settings.media_type == 'video' }}"
    },
    {
      "type": "header",
      "content": "t:content.mobile_media"
    },
    {
      "type": "checkbox",
      "id": "custom_mobile_media",
      "label": "t:settings.custom_mobile_media",
      "default": false
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "t:settings.image",
      "visible_if": "{{ section.settings.custom_mobile_media and section.settings.media_type == 'image' }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "t:settings.media_position",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "t:settings.media_width",
      "options": [
        {
          "value": "narrow",
          "label": "t:options.narrow"
        },
        {
          "value": "medium",
          "label": "t:options.medium"
        },
        {
          "value": "wide",
          "label": "t:options.wide"
        }
      ],
      "default": "medium"
    },
    {
      "type": "select",
      "id": "media_height",
      "label": "t:settings.media_height",
      "options": [
        {
          "value": "auto",
          "label": "t:options.auto"
        },
        {
          "value": "50svh",
          "label": "t:options.small"
        },
        {
          "value": "60svh",
          "label": "t:options.medium"
        },
        {
          "value": "80svh",
          "label": "t:options.large"
        }
      ],
      "default": "60svh"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.section_width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.appearance"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "select",
      "id": "content_alignment",
      "label": "t:settings.alignment",
      "options": [
        {
          "value": "left",
          "label": "t:options.left"
        },
        {
          "value": "center",
          "label": "t:options.center"
        },
        {
          "value": "right",
          "label": "t:options.right"
        }
      ],
      "default": "left"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:portal.brand_story_name",
      "category": "t:portal.category",
      "settings": {
        "media_width": "medium",
        "media_height": "60svh",
        "gap": 32
      },
      "blocks": [
        {
          "type": "text",
          "settings": {
            "text": "t:portal.bs_default_heading",
            "type_preset": "h2"
          }
        },
        {
          "type": "text",
          "settings": {
            "text": "t:portal.bs_default_body",
            "type_preset": "rte",
            "max_width": "normal"
          }
        },
        {
          "type": "button",
          "settings": {
            "label": "t:portal.bs_default_button_label",
            "link": "shopify://pages/about",
            "style_class": "button-secondary"
          }
        }
      ]
    }
  ]
}
{% endschema %}
