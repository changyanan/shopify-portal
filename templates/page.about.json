/*
 * ------------------------------------------------------------
 * Portal 定制:关于我们页面模板(page.about)。
 *
 * 基于 Shopify Page 数据(closest.page 标题与富文本内容),并预组合
 * Portal 的品牌故事、卖点和邮件订阅 section,商家可在 Theme Editor
 * 中自由增删、排序与配置。使用方法:在 Shopify 后台为"关于我们"页面
 * 选择"about"模板。
 * ------------------------------------------------------------
 */
{
  "sections": {
    "main": {
      "type": "main-page",
      "blocks": {
        "heading": {
          "type": "text",
          "name": "t:names.title",
          "settings": {
            "text": "<h1>{{ closest.page.title }}</h1>",
            "width": "100%",
            "max_width": "normal",
            "alignment": "left",
            "type_preset": "h2",
            "font": "var(--font-body--family)",
            "font_size": "1rem",
            "line_height": "normal",
            "letter_spacing": "normal",
            "case": "none",
            "wrap": "pretty",
            "background": false,
            "background_color": "#00000026",
            "corner_radius": 0,
            "padding-block-start": 0,
            "padding-block-end": 0,
            "padding-inline-start": 0,
            "padding-inline-end": 0
          },
          "blocks": {}
        },
        "page-content": {
          "type": "page-content",
          "settings": {},
          "blocks": {}
        }
      },
      "block_order": [
        "heading",
        "page-content"
      ],
      "settings": {
        "content_direction": "column",
        "gap": 32,
        "background_color": "{{ settings.color_palette.background }}",
        "padding-block-start": 40,
        "padding-block-end": 80
      }
    },
    "brand-story": {
      "type": "portal-brand-story",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "{{ 'portal.about.story_heading' | t }}",
            "type_preset": "h2"
          },
          "blocks": {}
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "{{ 'portal.about.story_body' | t }}",
            "type_preset": "rte",
            "max_width": "normal"
          },
          "blocks": {}
        },
        "cta": {
          "type": "button",
          "settings": {
            "label": "{{ 'portal.about.cta_label' | t }}",
            "link": "{{ routes.contact_url }}",
            "style_class": "button-secondary",
            "width": "fit-content",
            "width_mobile": "fit-content"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading",
        "body",
        "cta"
      ],
      "settings": {
        "media_width": "medium",
        "media_height": "60svh",
        "gap": 32,
        "padding-block-start": 0,
        "padding-block-end": 48
      }
    },
    "selling-points": {
      "type": "portal-selling-points",
      "blocks": {
        "point-1": {
          "type": "portal-selling-point",
          "settings": {
            "icon": "truck",
            "heading": "{{ 'portal.about.value_1_heading' | t }}",
            "body": "{{ 'portal.about.value_1_body' | t }}"
          },
          "blocks": {}
        },
        "point-2": {
          "type": "portal-selling-point",
          "settings": {
            "icon": "lightning_bolt",
            "heading": "{{ 'portal.about.value_2_heading' | t }}",
            "body": "{{ 'portal.about.value_2_body' | t }}"
          },
          "blocks": {}
        },
        "point-3": {
          "type": "portal-selling-point",
          "settings": {
            "icon": "return",
            "heading": "{{ 'portal.about.value_3_heading' | t }}",
            "body": "{{ 'portal.about.value_3_body' | t }}"
          },
          "blocks": {}
        }
      },
      "block_order": [
        "point-1",
        "point-2",
        "point-3"
      ],
      "settings": {
        "heading": "{{ 'portal.about.values_heading' | t }}",
        "columns": 3,
        "padding-block-start": 0,
        "padding-block-end": 48
      }
    },
    "newsletter": {
      "type": "portal-newsletter",
      "blocks": {
        "heading": {
          "type": "text",
          "settings": {
            "text": "{{ 'portal.about.newsletter_heading' | t }}",
            "type_preset": "h2",
            "alignment": "center"
          },
          "blocks": {}
        },
        "body": {
          "type": "text",
          "settings": {
            "text": "{{ 'portal.about.newsletter_body' | t }}",
            "type_preset": "rte",
            "alignment": "center",
            "max_width": "narrow"
          },
          "blocks": {}
        },
        "signup": {
          "type": "email-signup",
          "settings": {
            "width": "custom",
            "custom_width": 60,
            "width_mobile": "custom",
            "custom_width_mobile": 100
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading",
        "body",
        "signup"
      ],
      "settings": {
        "content_alignment": "center",
        "vertical_alignment": "center",
        "background_color": "{{ settings.color_palette.color2 }}",
        "padding-block-start": 48,
        "padding-block-end": 48
      }
    }
  },
  "order": [
    "main",
    "brand-story",
    "selling-points",
    "newsletter"
  ]
}
